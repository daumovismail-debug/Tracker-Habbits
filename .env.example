# Скопируйте этот файл в .env и заполните значения

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Если оба заданы — на старте создаётся (или обновляется) ваш аккаунт.
# Иначе оставьте пустыми и зарегистрируйтесь через сайт.
# Telegram ID узнать можно у @userinfobot.
WEB_USER_ID=
WEB_PASSWORD=

# Адрес сайта — бот покажет кнопку «Открыть приложение».
# Например: http://139.59.153.139:8080  или  https://habits.example.com
WEB_URL=

# Часовой пояс
TZ=Asia/Aqtobe
