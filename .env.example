# Скопируйте этот файл в .env и заполните значения

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Ваш Telegram ID (узнать у @userinfobot) — чьи привычки показывает сайт
WEB_USER_ID=000000000

# Пароль для входа на сайт (придумайте свой; пусто — вход без пароля)
WEB_PASSWORD=

# Часовой пояс
TZ=Asia/Aqtobe
